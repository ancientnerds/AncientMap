FROM node:20-slim

WORKDIR /app

# Prod-Dependencies reichen: der SSR-Build externalisiert react, react-dom
# und die Seiten-Libraries — dist-ssr/entry-server.js importiert sie zur
# Laufzeit aus node_modules.
COPY ancient-nerds-map/package.json ancient-nerds-map/package-lock.json ./
RUN npm ci --omit=dev

# ssr/ zuerst: server.mjs ändert sich selten, dist-ssr bei jedem Deploy —
# so bleibt der ssr/-Layer im Cache.
COPY ancient-nerds-map/ssr ./ssr
# dist-ssr entsteht VOR dem Image-Build via `npm run build:ssr` (Deploy-Flow).
COPY ancient-nerds-map/dist-ssr ./dist-ssr

# node:20-slim ships a 'node' user at uid/gid 1000 — creating our own
# collided on the GID and failed the image build (deploy 2026-08-16).
USER node

# Ohne das rendert react-dom/server mit dem Development-Build (langsam,
# Dev-Warnungen im Log).
ENV NODE_ENV=production

EXPOSE 8500

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD node -e "fetch('http://localhost:8500/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "ssr/server.mjs"]
