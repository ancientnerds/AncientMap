# ANCIENT NERDS - Research Platform - Environment Configuration
# Copy this file to .env and fill in your values
#
# SECURITY WARNING: Never commit .env files with real credentials to git!
# This .env.example file contains only placeholder values.

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=ancient_map
POSTGRES_PASSWORD=<generate-secure-password>
POSTGRES_DB=ancient_map
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full database URL (constructed from above or set directly)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS (for rate limiting & caching)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=false

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
API_SECRET_KEY=<generate-with-openssl-rand-hex-32>

# CORS origins (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per day for each tier
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_FREE=1000
RATE_LIMIT_PRO=50000
RATE_LIMIT_ENTERPRISE=0  # 0 = unlimited

# =============================================================================
# DATA PIPELINE
# =============================================================================
# Directory for raw downloaded data
DATA_RAW_DIR=./data/raw

# Directory for processed data
DATA_PROCESSED_DIR=./data/processed

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# EXTERNAL API KEYS (REQUIRED)
# =============================================================================
# Mapbox - for map tiles (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=<your-mapbox-token>

# Cloudflare Turnstile (bot protection)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Use test keys for development: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

# Admin PIN for connector refresh (4 digits)
# Used to protect the connector status refresh button from abuse
ADMIN_PIN=<your-4-digit-pin>

# Smithsonian Open Access API - for museum artifacts
# Get your free key at: https://api.si.edu/
SMITHSONIAN_API_KEY=<your-smithsonian-api-key>

# =============================================================================
# DISCORD OAUTH (for user authentication)
# =============================================================================
# Create an app at: https://discord.com/developers/applications
# OAuth2 redirect URL: https://ancientnerds.com/api/auth/discord/callback
DISCORD_CLIENT_ID=<your-discord-client-id>
DISCORD_CLIENT_SECRET=<your-discord-client-secret>
DISCORD_REDIRECT_URI=https://ancientnerds.com/api/auth/discord/callback
DISCORD_GUILD_ID=932330696956063765

# =============================================================================
# AI AGENT CONFIGURATION
# =============================================================================
# Valid PINs for AI agent access (JSON format: {"PIN": "username"})
# Example: {"1234": "Alice", "5678": "Bob"}
# Generate secure PINs - do not use sequential or obvious numbers
AI_VALID_PINS={"<pin1>": "<username1>"}

# Session timeout in seconds (default: 1 hour)
AI_SESSION_TTL=3600

# Stale connection timeout in seconds (default: 5 minutes)
AI_STALE_TIMEOUT=300

# =============================================================================
# LYRA LLM (Anthropic — Claude Haiku)
# =============================================================================
# API key for Anthropic
LYRA_ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Max output tokens per LLM call
LYRA_MAX_TOKENS=8192

# Minimum temperature
LYRA_TEMPERATURE_MIN=0.0

# Model overrides (defaults to claude-haiku-4-5-20251001 for all)
# LYRA_MODEL_SUMMARIZE=claude-haiku-4-5-20251001
# LYRA_MODEL_POST=claude-haiku-4-5-20251001
# LYRA_MODEL_VERIFY=claude-haiku-4-5-20251001
# LYRA_MODEL_ARTICLE=claude-haiku-4-5-20251001
# LYRA_MODEL_IDENTIFY=claude-haiku-4-5-20251001
# LYRA_MODEL_IDENTIFY_ESCALATION=claude-haiku-4-5-20251001
# LYRA_MODEL_RESCORE=claude-haiku-4-5-20251001
# LYRA_MODEL_RELEVANCE=claude-haiku-4-5-20251001

# Agent chat model (used by the Lyra chatbot in the API)
LYRA_LLM_MODEL=claude-haiku-4-5-20251001

# =============================================================================
# LYRA BACKEND SELECTOR
# =============================================================================
# Controls which LLM the pipeline uses for article generation.
# "anthropic" = Claude (default)  |  "minimax" = MiniMax M2.7
LYRA_LLM_BACKEND=anthropic

# =============================================================================
# MINIMAX TOKEN PLAN (web search + M2.7 for article fact-checking)
# =============================================================================
# Get a Token Plan key (sk-cp-...) at https://platform.minimax.io
# Used by the article pipeline to web-search and verify claims per-section.
LYRA_MINIMAX_API_KEY=
# LYRA_MINIMAX_BASE_URL=https://api.minimax.io
# LYRA_MINIMAX_MODEL=MiniMax-M2.7
# Backend: "minimax" (default, structured corrections) or "anthropic" (Opus + web_search)
LYRA_ARTICLE_WEB_BACKEND=minimax

# =============================================================================
# THEO RESEARCH PIPELINE — Academic & Web Source APIs
# =============================================================================
# All optional — Theo works with whatever keys are available.
# No-key APIs (Semantic Scholar basic, OpenAlex, Crossref, Wikipedia,
# Internet Archive) are always active.

# Academic paper search (free key for higher rate limits)
# THEO_SEMANTIC_SCHOLAR_KEY=         # https://www.semanticscholar.org/product/api
# THEO_OPENALEX_KEY=                 # https://developers.openalex.org (30-sec signup)
THEO_OPENALEX_EMAIL=                 # Polite pool access (just your email)
THEO_CROSSREF_EMAIL=                 # Polite pool access (just your email)

# Open access & grey literature
# THEO_CORE_KEY=                     # https://core.ac.uk/services/api (free, instant)

# Cultural heritage institutions
# THEO_EUROPEANA_KEY=                # https://pro.europeana.eu/page/apis (free account)
# THEO_SMITHSONIAN_KEY=              # https://api.data.gov/signup/ (free)

# Open access PDF finder (no key needed, just email)
THEO_UNPAYWALL_EMAIL=                # https://unpaywall.org (100K lookups/day)

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# WEB SEARCH (SearXNG - Self-hosted, FREE FOREVER)
# =============================================================================
# Start with: docker compose up searxng
# Or manually: docker run -d --name searxng -p 8888:8080 searxng/searxng
SEARXNG_URL=http://localhost:8888
SEARXNG_PORT=8888

# =============================================================================
# EXTERNAL API KEYS (OPTIONAL - for enhanced functionality)
# =============================================================================
# Europeana API - for European cultural heritage content
# Get your free key at: https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=<your-europeana-api-key>

# CORE API - for academic papers
# Get your free key at: https://core.ac.uk/services/api
CORE_API_KEY=<your-core-api-key>

# GeoNames username - for geographic data
# Register for free at: https://www.geonames.org/login
# Then enable web services in your account settings
GEONAMES_USERNAME=<your-geonames-username>

# Google Books API key (optional, recommended for higher rate limits)
# Get your key at: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=<your-google-books-api-key>

# =============================================================================
# PGADMIN (development only - not for production!)
# =============================================================================
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=<change-this-password>
PGADMIN_PORT=5050
