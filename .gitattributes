*.geojson filter=lfs diff=lfs merge=lfs -text
public/data/geological/*.geojson !filter !diff !merge text
public/data/sites/index.json filter=lfs diff=lfs merge=lfs -text
public/data/sites/details/*.json filter=lfs diff=lfs merge=lfs -text
pipeline/data/wikidata_labels.json filter=lfs diff=lfs merge=lfs -text
ancient-nerds-map/public/landing/video/*.mp4 filter=lfs diff=lfs merge=lfs -text
*.json.gz filter=lfs diff=lfs merge=lfs -text
.githooks/* text eol=lf
scripts/*.sh text eol=lf
scripts/remediation/*.sh text eol=lf
# Statements that are piped into psql keep LF on every checkout, so a CRLF working copy cannot put a
# carriage return into a psql meta-command such as `\set ON_ERROR_STOP on` (not measured; avoided).
output/remediation/qid_repair/*.sql text eol=lf
# Hash-pinned evidence of the gallery audit (SUMMARY.json and the fixture's meta carry the sha256
# of these exact LF bytes): a CRLF checkout must not rewrite them.
tests/remediation/fixtures/gallery_labels_652.* text eol=lf
output/remediation/gallery_audit/liveness-*/* text eol=lf
# The liveness write's chunks: their APPLY.sql/ROLLBACK.sql are piped into psql.
output/remediation/gallery_audit/liveness-*/chunk-*/* text eol=lf
# The sealed C1 calibration: SEAL.jsonl records the sha256 of THRESHOLDS.json's LF bytes, the
# reported JOBS.jsonl digest is over LF bytes, and ADMISSION.json is re-derived from the ledger's
# exact bytes - a CRLF checkout must not make a byte-level check (sha256sum) disagree.
output/remediation/gallery_audit/calibration-*/* text eol=lf
# The DeepSeek C1 attempt of 2026-09-23 (four HTTP-401 lines, no verdict), kept as evidence of the
# failed attempt one level down: its sha256 is pinned over these LF bytes.
output/remediation/gallery_audit/calibration-*/failed-*/* text eol=lf
output/remediation/qid_repair/wave2/*.sql text eol=lf
output/remediation/qid_repair/wave3/*.sql text eol=lf
output/remediation/qid_repair/wave4/*.sql text eol=lf
output/remediation/bcases/coords_plan/*.sql text eol=lf
output/remediation/bcases/coords_plan_wave2/*.sql text eol=lf
output/remediation/bcases/coords3/*.jsonl text eol=lf
output/remediation/opus_audit/*.jsonl text eol=lf
output/remediation/opus_audit/*.md text eol=lf
# AUDIT_LOG.md records the sha256 of VERDICTS_RAW.json and of the audit's JSON outputs as LF bytes.
output/remediation/opus_audit/*.json text eol=lf
# The Phase-4 pilot's sealed artefacts (PILOT.jsonl, gold_prose_errors.json, PILOT_THRESHOLDS.md) and
# the reads and ledgers beside them: AUDIT_LOG.md records the sha256 of these exact LF bytes before
# the first model question, so a CRLF checkout must not make that check disagree.
output/remediation/phase4_runner/*.jsonl text eol=lf
output/remediation/phase4_runner/*.json text eol=lf
output/remediation/phase4_runner/*.md text eol=lf
