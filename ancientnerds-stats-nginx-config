# stats.ancientnerds.com — the Umami dashboard behind the Discord/Founder gate
# (api/routes/stats_access.py). Staged here, not yet in ancientnerds-nginx-config:
# the ssl_certificate lines below need the Let's Encrypt files to exist, and
# nginx -t (and with it the deploy's config step) fails while they do not.
#
# Go-live, in this order:
#   1. DNS: A record stats.ancientnerds.com -> 213.199.53.42 (owner).
#   2. Certificate (root, once). The port-80 block for stats.* already lives
#      in ancientnerds-nginx-config and serves the ACME challenge from
#      /var/www/ancientnerds/acme:
#        sudo certbot certonly --webroot -w /var/www/ancientnerds/acme -d stats.ancientnerds.com
#   3. Paste this server block into ancientnerds-nginx-config (below the main
#      443 server) and push; the deploy runs nginx -t and reloads.
#   4. Create the co-founder's Umami login (the dashboard keeps its own login
#      as the second lock; enable 2FA in the Umami profile).

server {
    listen 443 ssl http2;
    server_name stats.ancientnerds.com;

    ssl_certificate /etc/letsencrypt/live/stats.ancientnerds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stats.ancientnerds.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Nobody indexes a dashboard.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Every request is checked: the gate reads the an_stats cookie (signed,
    # HttpOnly, Domain=.ancientnerds.com) and answers 204 or 401.
    location = /_gate {
        internal;
        proxy_pass http://an_api/api/auth/stats-gate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    # 401 from the gate: show the entry page (Discord login), not a redirect
    # loop. The named location may not carry a URI in proxy_pass, hence the
    # rewrite. The entry page is served with the stats host in the address
    # bar, so the browser lands back here after the Discord round trip.
    location @entry {
        rewrite ^ /api/auth/stats-login break;
        proxy_pass http://an_api;
        proxy_set_header Host $host;
    }

    # Sign-out link for the dashboard's users: clears the gate cookie.
    location = /logout {
        rewrite ^ /api/auth/stats-logout break;
        proxy_pass http://an_api;
        proxy_set_header Host $host;
    }

    location / {
        auth_request /_gate;
        error_page 401 = @entry;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
