# LLM model to pull on first boot (default: qwen3:8b)
OLLAMA_MODEL=qwen3:8b

# Shared API key for authenticating requests through nginx
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=change-me-to-random-secret

# Reranker model (default: ms-marco-MiniLM-L-12-v2, ~130MB ONNX)
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Nginx listen port (default: 8080)
NGINX_PORT=8080
