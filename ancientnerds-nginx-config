# SEO: Detect crawler user-agents for pre-rendered site pages (/?site={uuid})
map $http_user_agent $is_bot {
    default 0;
    ~*(Googlebot|bingbot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Applebot|Pinterestbot|YandexBot|DuckDuckBot) 1;
}

server {
    server_name ancientnerds.com www.ancientnerds.com;

    root /var/www/ancientnerds/ancient-nerds-map/dist;
    index index.html;

    # Force service worker to always revalidate
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Force every HTML entry point to revalidate. Without this, a stale
    # cached /theo.html (or any other entry) can reference an old hashed JS
    # bundle that's no longer deployed — users keep running the previous
    # version of the page until they hard-refresh. The hashed assets
    # themselves stay cache-safe; only the HTML shells must always be fresh.
    location ~* \.html$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Workbox files - no cache
    location ~* ^/workbox.*\.js$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SEO: Article pages served by API as HTML
    location /articles/ {
        proxy_pass http://127.0.0.1:8000/articles/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=3600";
    }

    # SEO: News archive served by API as HTML
    location /news-archive/ {
        proxy_pass http://127.0.0.1:8000/news-archive/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=1800";
    }

    # SEO: Research library papers served by API as HTML
    location /research/ {
        proxy_pass http://127.0.0.1:8000/research/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=1800";
    }

    # SEO: Crawlable site browse pages served by API as HTML
    location /sites/ {
        proxy_pass http://127.0.0.1:8000/sites/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "public, max-age=3600";
    }

    # Bulk site operations need a long timeout (large imports)
    location /api/sites/batch-upload {
        proxy_pass http://127.0.0.1:8000/api/sites/batch-upload;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    location /api/sites/replace-source {
        proxy_pass http://127.0.0.1:8000/api/sites/replace-source;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    # Webcam stream proxy (HLS extraction + CORS proxy for SkylineWebcams)
    location /webcam-proxy/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }

    # Static data files (sites, sources, etc.) — served directly from public/data/
    # NOT inside dist/ to avoid doubling 1.3GB+ of exported JSON
    location /data/ {
        alias /var/www/ancientnerds/public/data/;
        add_header Cache-Control "public, max-age=3600";
        gzip_static on;
    }

    # Wiki images — served by API container (files are inside Docker)
    location /data/images/wiki/ {
        proxy_pass http://127.0.0.1:8000/data/images/wiki/;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }

    # Static news feed + screenshots — served directly, no API
    location /data/news/ {
        alias /var/www/ancientnerds/public/data/news/;
        add_header Cache-Control "public, max-age=300";
        gzip_static on;
    }

    # Redirect legacy /?site={uuid} URLs to the canonical /site.html?id={uuid}
    # Applies to all visitors (bots and users) — Googlebot follows the 301 and
    # hits /site.html which has its own pre-rendering block below.
    location = / {
        if ($arg_site ~ "^[0-9a-fA-F-]{36}$") {
            return 301 /site.html?id=$arg_site;
        }
        try_files /index.html =404;
    }

    # Internal: proxied pre-rendered site pages (reached via rewrite in /site.html block)
    location /seo/site/ {
        internal;
        proxy_pass http://127.0.0.1:8000/seo/site/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Sitemap — static file, refreshed on each deploy
    location = /sitemap.xml {
        try_files /sitemap.xml =404;
        add_header Content-Type "application/xml; charset=UTF-8";
        add_header Cache-Control "public, max-age=86400";
    }

    # SEO: Pre-rendered HTML for crawlers hitting /site.html?id={uuid}
    location = /site.html {
        set $seo_redirect_site "";
        if ($is_bot) {
            set $seo_redirect_site "B";
        }
        if ($arg_id ~ "^[0-9a-fA-F-]{36}$") {
            set $seo_redirect_site "${seo_redirect_site}S";
        }
        if ($seo_redirect_site = "BS") {
            rewrite ^ /seo/site/$arg_id? last;
        }
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl default_server;
    ssl_certificate /etc/letsencrypt/live/ancientnerds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ancientnerds.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = www.ancientnerds.com) {
        return 301 https://$host$request_uri;
    }

    if ($host = ancientnerds.com) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name ancientnerds.com www.ancientnerds.com;
    return 404;
}
