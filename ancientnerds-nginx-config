# Two API instances; the deploy restarts one at a time, so nginx always has
# a live backend. On connection errors it retries the other instance
# (proxy_next_upstream default: error timeout).
upstream an_api {
    server 127.0.0.1:8000 max_fails=1 fail_timeout=5s;
    server 127.0.0.1:8001 max_fails=1 fail_timeout=5s;
}

# Referral log: every request that arrives with a referer from another host
# or with a utm_source (ChatGPT tags its links and often sends no referer),
# as JSON lines in a file the deploy user can read (/var/log/nginx is 0640
# www-data:adm and sudo is limited to the three deploy commands). Purpose:
# see whether AI assistants (chatgpt.com, perplexity.ai, ...) and search
# engines send people here — the zero-click question of 2026-09-17.
# No client IP on purpose; logrotate does not touch the path, the volume is
# a few hundred lines a day. Reader: scripts/referral_report.py.
log_format referral escape=json '{"t":"$time_iso8601","ref":"$http_referer","req":"$request_method $request_uri","status":$status,"ua":"$http_user_agent"}';

map $http_referer $external_referral {
    default 1;
    "" 0;
    ~*^https?://([a-z0-9-]+\.)*ancientnerds\.com(/|:|$) 0;
}

# 0 only when the referer is ours or missing AND no utm_source is present.
map "$external_referral$arg_utm_source" $log_referral {
    default 1;
    "0" 0;
}

# JS-executing scrapers that open the site pages' fan-out endpoints while
# rendering and then abort: 106 of 738 /api/content/by-site requests ended
# 499 on 12.–15.09.2026 (91 % of YouBot's, 30 % of meta-externalagent's),
# each leaving a 15–30 s external fan-out running. Search engines are not
# in this list — they obey the robots.txt disallow on /api/ anyway.
map $http_user_agent $is_scraper {
    default 0;
    ~*(YouBot|meta-externalagent|Amazonbot|PetalBot|Barkrowler|MJ12bot|SemrushBot|AhrefsBot|DotBot|DataForSeoBot|BLEXBot) 1;
}

server {
    server_name ancientnerds.com www.ancientnerds.com;

    root /var/www/ancientnerds/ancient-nerds-map/dist;
    index index.html;

    # An access_log here replaces the http-level one, so the main log is
    # repeated (same file and combined format as nginx.conf) next to the
    # referral log.
    access_log /var/log/nginx/access.log;
    access_log /var/www/ancientnerds/logs/referrals.log referral if=$log_referral;

    # /etc/nginx/nginx.conf has `gzip on` but its gzip_types line is commented
    # out, so the default applied — text/html only. Result: 27 asset requests
    # per cold visit, 2.5 MB, none with content-encoding (measured 2026-08-09).
    # Set here rather than in nginx.conf because only this file is in the repo
    # and rolled out by the deploy.
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    # Deliberately no image/*, font/woff2 or video/*: those are already
    # compressed, and re-compressing them costs CPU for nothing.
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        application/atom+xml
        application/manifest+json
        image/svg+xml;

    # A deploy runs `docker compose up -d --build api`, which leaves the
    # upstream unreachable for about 110 seconds. nginx answered 502 during
    # that window — 509 of them since 27.07., 138 to Googlebot. But 502 means
    # "the gateway is broken", and repeated 502s make Google reduce its crawl
    # rate. A restart is not a broken gateway: 503 with Retry-After is the
    # accurate answer, and Google honours it instead of backing off.
    #
    # This corrects the status code. It does NOT remove the downtime — that
    # needs a second API container to restart against (see the audit report).
    # Measured 2026-08-10: three deploys, windows of 110s, 87s and 110s.
    error_page 502 504 = @upstream_restarting;

    location @upstream_restarting {
        add_header Retry-After 120 always;
        add_header Cache-Control "no-store" always;
        default_type text/plain;
        return 503 "Service restarting. Please retry in a couple of minutes.\n";
    }

    # Force service worker to always revalidate
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Force every HTML entry point to revalidate. Without this, a stale
    # cached /theo.html (or any other entry) can reference an old hashed JS
    # bundle that's no longer deployed — users keep running the previous
    # version of the page until they hard-refresh. The hashed assets
    # themselves stay cache-safe; only the HTML shells must always be fresh.
    location ~* \.html$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Workbox files - no cache
    location ~* ^/workbox.*\.js$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # proxy_intercept_errors on den vier SSR-Routen: das error_page oben
    # wandelt nur 502er um, die NGINX SELBST erzeugt (Upstream nicht
    # erreichbar). Seit dem Rolling-Restart ist der Upstream aber immer
    # erreichbar — der Deploy startet `ssr` zuerst, und in diesem Fenster
    # laufen api und api2 weiter, finden ihren Sidecar nicht und antworten
    # SELBST mit 502 (SsrUnavailableError, api/seo_shell.py). Das reichte
    # nginx unverändert durch: 12 solcher 502 in 15 Tagen, ausschliesslich
    # auf /sites/, /news-archive/ und /research/, geballt an Deploy-Tagen
    # (10.09.: fünf Stück). Mit intercept greift @upstream_restarting auch
    # hier — 503 + Retry-After statt "Gateway kaputt".
    #
    # Nur 502/504 werden abgefangen: für andere Codes ist kein error_page
    # definiert, also bleiben die 404 der Routen (render_error_html) und ein
    # echtes 500 unverändert sichtbar. Ein Bug soll NICHT als 503 erscheinen.

    # Slash normalisation for the four SSR trees (render audit 2026-09-15):
    #  - /sites, /research, /articles, /news-archive without the slash fell
    #    through to `location /` and answered 200 with the homepage shell;
    #  - /sites/england/ and /news-archive/page/2/ reached FastAPI, whose
    #    redirect_slashes answered 307 to http://…, then nginx 301'd to https
    #    (two hops, temporary, wrong scheme).
    # One permanent hop each. $request_uri keeps the original percent-encoding
    # (türkiye), $uri would have decoded it into the Location header.
    location ~ ^/(sites|research|articles|news-archive)$ {
        return 301 https://ancientnerds.com$uri/;
    }
    if ($request_uri ~ "^(/(?:sites|research|articles|news-archive)/[^?]+)/(\?.*)?$") {
        return 301 https://ancientnerds.com$1$2;
    }

    # SEO: Article pages served by API as HTML
    location /articles/ {
        proxy_pass http://an_api/articles/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
    }

    # SEO: News archive served by API as HTML
    location /news-archive/ {
        proxy_pass http://an_api/news-archive/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
    }

    # SEO: Research library papers served by API as HTML
    location /research/ {
        proxy_pass http://an_api/research/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
    }

    # SEO: Crawlable site browse pages served by API as HTML
    location /sites/ {
        proxy_pass http://an_api/sites/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
    }

    # Funnel measurement: same-origin Discord redirect. The API logs one
    # structured line per click (src + bot flag, no IP/referer) and answers
    # 302 — read the numbers with scripts/funnel_report.py. no-store because
    # a cached redirect would skip the API and hide the click from the log.
    location = /goto/discord {
        proxy_pass http://an_api/goto/discord;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    # Bulk site operations need a long timeout (large imports)
    location /api/sites/batch-upload {
        proxy_pass http://an_api/api/sites/batch-upload;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    location /api/sites/replace-source {
        proxy_pass http://an_api/api/sites/replace-source;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    # Fan-out endpoints (external connectors, 15–30 s): scrapers get 403
    # before the proxy; see the $is_scraper map.
    location ^~ /api/content/by-site {
        if ($is_scraper) { return 403; }
        proxy_pass http://an_api/api/content/by-site;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
        add_header X-Robots-Tag "noindex" always;
    }
    location ^~ /api/library/by-site {
        if ($is_scraper) { return 403; }
        proxy_pass http://an_api/api/library/by-site;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
        add_header X-Robots-Tag "noindex" always;
    }

    location /api/ {
        proxy_pass http://an_api/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
        # robots.txt now allows /api/sites/ and /api/news/screenshots/ so
        # Google's RENDERER can fetch them (blocked, the hydrated detail pages
        # hung in their loading state and were filed as Soft 404). noindex
        # keeps the JSON answers themselves out of the index.
        add_header X-Robots-Tag "noindex" always;
    }

    # Webcam stream proxy (HLS extraction + CORS proxy for SkylineWebcams)
    location /webcam-proxy/ {
        proxy_pass http://127.0.0.1:8765/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }

    # Static data files (sites, sources, etc.) — served directly from public/data/
    # NOT inside dist/ to avoid doubling 1.3GB+ of exported JSON
    location /data/ {
        alias /var/www/ancientnerds/public/data/;
        add_header Cache-Control "public, max-age=3600";
        gzip_static on;
    }

    # Wiki images — served by API container (files are inside Docker)
    location /data/images/wiki/ {
        proxy_pass http://an_api/data/images/wiki/;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }

    # Static news feed + screenshots — served directly, no API
    location /data/news/ {
        alias /var/www/ancientnerds/public/data/news/;
        add_header Cache-Control "public, max-age=300";
        gzip_static on;
    }

    # Homepage: server-rendered by the API (GET /home — live Stories/Journal/
    # Papers sections, api/routes/landing_html.py). While the API or the SSR
    # sidecar restarts, the static build is served instead: the page stays up
    # with the three live sections empty. proxy_intercept_errors is needed
    # because the API answers 502 itself when the sidecar is down — and it is
    # what makes an upstream-returned status interceptable here at all. 500
    # too — an exception in the landing route must not take the homepage down.
    location = / {
        # Legacy /?site={uuid}: hand it to the API's legacy resolver
        # internally, which answers ONE 301 to /sites/{country}/{slug}.
        # Until 2026-09-15 this was `return 301 /site.html?id=…`, i.e. two
        # external hops for every old share link.
        if ($arg_site ~ "^[0-9a-fA-F-]{36}$") {
            rewrite ^ /site.html?id=$arg_site? last;
        }
        proxy_pass http://an_api/home;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
        # 404 too: the deploy applies this config before the API container is
        # rebuilt, so for ~2 min the old API has no /home route (seen 09.09.2026).
        error_page 404 500 502 504 = @home_static;
    }

    location @home_static {
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # Sitemap index + per-type part files — served live by the API instead
    # of a deploy-time frozen copy, so new stories/papers are advertised
    # without a deploy. The API sets Cache-Control (public, max-age=3600)
    # and the XML content type on every sitemap response.
    location = /sitemap.xml {
        proxy_pass http://an_api/api/sitemap/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Part files (SITEMAP_PARTS in api/routes/sitemap.py). Listed regex
    # locations win over the prefix try_files cascade; the \.html$ block
    # above never matches .xml paths.
    location ~ ^/sitemap-(static|sites|countries|stories|research|articles|legacy)\.xml$ {
        proxy_pass http://an_api/api/sitemap$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Legacy site URL. /sites/{country}/{slug} is now the canonical page and
    # serves identical content to every user agent, so the old parameter URL
    # just 301s there (the API resolves the uuid to its slug). This also
    # retires the crawler user-agent rewrite that used to live here — showing
    # crawlers different content than users is cloaking-adjacent and Google
    # never fetched those URLs anyway.
    location = /site.html {
        proxy_pass http://an_api/site.html;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Legacy research URL -> canonical /research/{slug}
    location = /research.html {
        proxy_pass http://an_api/research.html;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Vite's hashed bundles: the name changes with the content — a year, immutable.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Umami analytics (docker-compose.yml, 127.0.0.1:3000; dashboard only via
    # SSH tunnel). Tracker and collect endpoint under our own names on the
    # main domain: first-party, and generic enough to stay off the blocker
    # lists that match script.js / api/send. Exact matches win over the
    # .html regex and the /api/ prefix.
    location = /pulse.js {
        proxy_pass http://127.0.0.1:3000/pulse.js;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }
    location = /api/pulse {
        proxy_pass http://127.0.0.1:3000/api/pulse;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Landing screenshots, hero poster and video, self-hosted fonts: versionless
    # names that change rarely — a week in the browser. Rename a file to replace it.
    location ^~ /landing/ {
        add_header Cache-Control "public, max-age=604800";
    }
    location ^~ /fonts/ {
        add_header Cache-Control "public, max-age=604800";
    }

    # Anything no other location serves: a real 404 from the API's error
    # shell (GET /not-found, render_error_html). Until 2026-09-17 this fell
    # back to index.html, so every mistyped or retired URL answered 200 with
    # the homepage — a soft 404 each (/seo/site/…, /seo/, /definitely-not-a-page
    # all returned 50 KB of landing shell). Named location: proxy_pass may not
    # carry a URI there, so the rewrite sets the upstream path.
    location / {
        try_files $uri $uri/ @not_found;
    }

    location @not_found {
        rewrite ^ /not-found break;
        proxy_pass http://an_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # www served the complete site with 200 alongside the apex — two hostnames
    # carrying all 7,404 indexed URLs (verified 2026-08-09). The certificate
    # covers both, so www can answer and redirect rather than fail.
    if ($host = www.ancientnerds.com) {
        return 301 https://ancientnerds.com$request_uri;
    }

    listen 443 ssl http2 default_server;
    ssl_certificate /etc/letsencrypt/live/ancientnerds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ancientnerds.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    # $host would have kept www on the way to HTTPS; go straight to the apex.
    if ($host = www.ancientnerds.com) {
        return 301 https://ancientnerds.com$request_uri;
    }

    if ($host = ancientnerds.com) {
        return 301 https://ancientnerds.com$request_uri;
    }

    listen 80;
    server_name ancientnerds.com www.ancientnerds.com;
    return 404;
}
