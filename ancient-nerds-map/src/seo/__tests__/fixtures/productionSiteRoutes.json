 "Serpent's Wall": {
  "type": "site",
  "id": "7ee8535b-b034-498c-9311-466662e75e58",
  "name": "Serpent's Wall",
  "country": "Ukraine",
  "site_type": "Earthwork",
  "period_name": "500 BC - 1 AD",
  "period_start": -500,
  "period_end": null,
  "description": "The Serpent's Wall (Ukrainian: Змієві вали, Zmiievi valy) is an ancient system of earthworks spanning approximately 1,000 km across central Ukraine, primarily in Kyiv Oblast. Built between 500 BC and 1 AD, these fortifications represent less than 20% of the original complex [1]. The earthworks are structurally and functionally similar to Trajan's Wall in Bessarabia, likely serving as defensive boundaries [1]. The system stretches across the middle Dnieper region (Naddniprianshchyna), with remnants still visible today [1].",
  "lat": 50.28836232147972,
  "lon": 30.50227859536824,
