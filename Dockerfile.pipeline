FROM python:3.11-slim

WORKDIR /app

# Install build + runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (full pipeline)
COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-pipeline.txt

# Copy code only — data dirs are mounted as volumes
COPY pipeline/ ./pipeline/
COPY scripts/ ./scripts/

# Create empty data dirs (mount points)
RUN mkdir -p /app/data/raw /app/public/data /app/ancient-nerds-map/public/data

# Non-root user (DS-0002, container-scan gate 2026-08-06). uid 1000 matches
# the api/lyra containers AND the VPS deploy user that owns the mounted
# data dirs, so volume writes keep working.
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser && \
    chown -R appuser:appgroup /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

CMD ["python", "scripts/rebuild_all.py"]
