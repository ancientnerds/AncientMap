FROM python:3.11-slim

WORKDIR /app

# Install build + runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (full pipeline)
COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-pipeline.txt

# Copy code only — data dirs are mounted as volumes
COPY pipeline/ ./pipeline/
COPY scripts/ ./scripts/

# Create empty data dirs (mount points)
RUN mkdir -p /app/data/raw /app/public/data /app/ancient-nerds-map/public/data

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

CMD ["python", "scripts/rebuild_all.py"]
